{
  "name": "el-mejor-bot",
  "version": "1.0.0",
  "private": true,
  "description": "Bot de WhatsApp con utilidades de stickers, descargas sociales, traducción y Fortnite; sesión cifrada persistida en GitHub.",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "check": "find . -path './node_modules' -prune -o -path './.git' -prune -o -type f -name '*.js' -print0 | xargs -0 -n1 node --check",
    "test": "node --test"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@whiskeysockets/baileys": "6.7.24",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "pino": "^10.3.1",
    "qrcode": "^1.5.4",
    "sharp": "^0.34.3",
    "wa-sticker-formatter": "^4.4.4",
    "youtube-dl-exec": "^3.1.15",
    "puppeteer": "^25.11.0"
  },
  "allowScripts": {
    "@whiskeysockets/baileys": true,
    "youtube-dl-exec": true,
    "puppeteer": true,
    "protobufjs": true,
    "sharp": true
  }
}
